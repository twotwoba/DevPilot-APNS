# 复制为 .env 后填写；权限建议 0600。
# docker compose 会把本文件同时用于变量替换（${DOMAIN}）与 relay 环境变量。

# ---------- Caddy ----------
DOMAIN=relay.example.com

# ---------- relay ----------
PUBLIC_BASE_URL=https://relay.example.com
LOG_LEVEL=info

# .p8 在容器内的只读挂载路径（对应 deploy/secrets/apns.p8）。
APNS_KEY_PATH=/run/secrets/apns.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.twotwoba.devpilot
APNS_LIVEACTIVITY_TOPIC=com.twotwoba.devpilot.push-type.liveactivity
APNS_ENVIRONMENT=production

# ---------- 配额（per-daemon;0=关闭对应闸）----------
RATE_EVENT_FREE=10
RATE_EVENT_PRO=60
RATE_EVENT_WINDOW_SECONDS=60
QUOTA_DAILY_FREE=20
QUOTA_DAILY_PRO=5000
QUOTA_EXEMPT_APPROVALS=1

# ---------- 生命周期 TTL（天;0=禁用）----------
# 首发部署保持 0,观察稳定后再开(如 30)。
DAEMON_TTL_DAYS=0
DEVICE_TTL_DAYS=0

# /metrics 保护;留空则 metrics 公开(建议 Caddy 层同时 respond 404 兜底)。
METRICS_TOKEN=

# ---------- 防滥用 ----------
# Caddy 反代下必须设 1(relay 才能从 XFF 还原真实客户端 IP;0=忽略 XFF)。
TRUSTED_PROXY_COUNT=1
PAIR_SESSION_LIMIT=15
PAIR_ATTEMPT_LIMIT=10
BAN_ENABLED=1
BAN_THRESHOLD=100
BAN_WINDOW_SECONDS=300
BAN_TTL_SECONDS=86400

# 仅本机联调时打开：不会真正请求 Apple。
# APNS_MOCK=1
